#  Python / editor
# ---------------------------------------------------------------------------
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/
build/
dist/
*.egg-info/
.vscode/
.idea/
*.swp
Thumbs.db
desktop.ini
.DS_Store
